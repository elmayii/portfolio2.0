// srperera-api — POST https://api.srperera.com/lead (contract: workspace workspace/contracts/sb-01-01.md).
// Run from this folder with `npx wrangler@4 ...`; no package.json on purpose (DECISIONS 2026-10-26).
{
	"$schema": "https://unpkg.com/wrangler@4.152.0/config-schema.json",
	"name": "srperera-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-20",
	"workers_dev": false,
	// Own subdomain: a route on srperera.com/api/* never fires, because Pages serves srperera.com (DECISIONS 2026-10-27).
	"routes": [{ "pattern": "api.srperera.com", "custom_domain": true }],
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "srperera",
			"database_id": "f084ab8b-0ea0-4963-9199-1acd6017b5ff"
		}
	],
	"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["guides@mail.srperera.com"] }],
	// Per-IP limit on the web (Turnstile) path. namespace_id must be unique in the account.
	"ratelimits": [{ "name": "WEB_LIMIT", "namespace_id": "2601", "simple": { "limit": 5, "period": 60 } }],
	"vars": { "TURNSTILE_HOSTNAMES": "srperera.com" },
	// Values are set by the human with `wrangler secret put`; deploy fails while any is missing.
	"secrets": { "required": ["LEAD_SECRET", "TURNSTILE_SECRET"] }
}
