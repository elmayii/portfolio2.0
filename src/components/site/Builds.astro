---
import { copy, langOf } from '../../data/i18n';

const { builds, ui } = copy(langOf(Astro.currentLocale));
const t = ui.builds;
---

<section id="built" class="band">
  <div class="wrap inner">
    <div class="head">
      <div class="titles">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="section-title">{t.title}</h2>
      </div>
      <a class="link-arrow" href="https://github.com/elmayii">{t.github}</a>
    </div>

    <div class="grid">
      {
        builds.map((b) => (
          <article>
            <img
              src={b.image}
              alt={b.alt}
              loading="lazy"
              decoding="async"
              width="1200"
              height="750"
              style={`object-position: ${b.position}`}
            />
            <div class="body">
              <span class="mono stack">{b.stack}</span>
              <h3>{b.name}</h3>
              <p>{b.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="also">{t.also}</p>
  </div>
</section>

<style>
  .band {
    background: var(--paper);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  article {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
  }

  .stack {
    font-size: 12px;
    color: var(--muted);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
  }

  p {
    margin: 0;
    font-size: 16px;
    color: var(--body);
  }

  .also {
    font-size: 15px;
    color: var(--muted);
  }
</style>
