---
import SiteHeader from './SiteHeader.astro';
import SubscribeForm from './SubscribeForm.astro';
import { copy, langOf } from '../../data/i18n';

const { site, ui } = copy(langOf(Astro.currentLocale));
const t = ui.hero;
---

<div class="hero-shell">
  <SiteHeader home />

  <section id="top" class="wrap hero">
    <div class="copy">
      <div class="byline">
        <img class="avatar" src="/partner-mario-perera.jpg" alt="Mario Perera" width="200" height="200" />
        <p class="kicker"><span aria-hidden="true"></span>{t.kicker}</p>
      </div>
      <h1>
        {t.welcome}<br />
        <span class="accent"><span class="strike">SaaS</span>-Killing World.</span>
      </h1>
      <p class="lede">{t.lede}</p>
      <div id="join">
        <SubscribeForm id="hero-email" source="hero" />
      </div>
      {site.readers && <p class="count"><strong>{site.readers}</strong> {t.readers}</p>}
    </div>

    <!-- ponytail: the 1px source keeps phones from downloading the 390KB photo they never show. -->
    <picture class="hero-photo">
      <source media="(max-width: 760px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
      <img
        src="/HeroImage.jpg"
        alt={t.photoAlt}
        width="1706"
        height="2560"
        fetchpriority="high"
      />
    </picture>
  </section>
</div>

<style>
  .hero-shell {
    background: var(--paper);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(420px, 40%);
    align-items: center;
    gap: 56px;
    padding-top: 40px;
    padding-bottom: 88px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-width: 0;
  }

  /* Straight crop, no fade. Anchored to the top so the whole head stays in, gaze pointing at the headline. */
  .hero-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 0%;
    border-radius: 8px;
    background: var(--rule);
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .avatar {
    display: none;
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }

  .kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kicker span {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--blue);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 4.7vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .accent {
    color: var(--blue);
  }

  .lede {
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    max-width: 44ch;
    color: #3A3D42;
  }

  .count {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .count strong {
    color: var(--ink);
  }

  /* Phones: the talk photo would sit below the fold, so a small face-to-camera avatar goes next to the headline. */
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 24px;
      padding-bottom: 64px;
    }

    .hero-photo {
      display: none;
    }

    /* Keeps "Welcome to the" on one line down to 320px wide. */
    h1 {
      font-size: min(40px, 9.5vw);
    }

    .avatar {
      display: block;
    }
  }
</style>
