---
import SiteHeader from './SiteHeader.astro';
import SubscribeForm from './SubscribeForm.astro';
import Receipt from './Receipt.astro';
import { site } from '../../data/site';
---

<SiteHeader />

<section id="top" class="wrap hero">
  <div class="copy">
    <p class="eyebrow">Mario Perera · software engineer · free newsletter</p>
    <h1>Welcome to the <span class="strike">SaaS</span>-Killing World</h1>
    <p class="lede">I rebuild the apps you pay for every month with AI, and show you exactly how. Free.</p>
    <div id="join">
      <SubscribeForm id="hero-email" source="hero" variant="split" button="JOIN FREE" />
    </div>
    <p class="count mono">{site.readers} readers · one build a week · leave in one click</p>
  </div>

  <div class="photo">
    <img
      src="/images/mario-talk.jpg"
      alt="Mario Perera explaining a model in front of a screen"
      width="960"
      height="1200"
      fetchpriority="high"
    />
    <Receipt overlap />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 64px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 88px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(38px, 4.5vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  h1 .strike {
    text-decoration-thickness: 0.12em;
  }

  .lede {
    margin: 0;
    max-width: 34ch;
    font-size: 21px;
    line-height: 1.5;
    color: var(--body);
  }

  .count {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .photo {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 480px;
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 60% 30%;
    border-radius: 8px;
    background: var(--rule);
  }
</style>
