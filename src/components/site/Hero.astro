---
import SiteHeader from './SiteHeader.astro';
import SubscribeForm from './SubscribeForm.astro';
import { site } from '../../data/site';
---

<div class="hero-shell">
  <img
    class="hero-photo"
    src="/images/mario-portrait-bw.jpg"
    alt="Mario Perera"
    width="1100"
    height="1324"
    fetchpriority="high"
  />
  <div class="hero-fade" aria-hidden="true"></div>

  <SiteHeader home />

  <section id="top" class="wrap hero">
    <div class="copy">
      <p class="kicker"><span aria-hidden="true"></span>Free newsletter · weekly builds</p>
      <h1>
        Welcome to the<br />
        <span class="accent"><span class="strike">SaaS</span>-Killing World.</span>
      </h1>
      <p class="lede">
        I rebuild the apps you pay for every month with AI and show you exactly how. What worked, what didn't. Free.
      </p>
      <div id="join">
        <SubscribeForm id="hero-email" source="hero" />
      </div>
      <p class="count"><strong>{site.readers}</strong> readers · free, no spam</p>
    </div>
  </section>
</div>

<style>
  .hero-shell {
    position: relative;
    overflow: hidden;
    background: var(--paper);
  }

  /* Portrait kept at its own proportions on the right, so the face takes about a third of the hero height. */
  .hero-photo {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    aspect-ratio: 1100 / 1324;
    max-width: 58%;
    object-fit: cover;
    object-position: 50% 30%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.55) 22%, #000 42%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.55) 22%, #000 42%);
  }

  .hero-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 140px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), var(--paper));
  }

  .hero {
    position: relative;
    z-index: 2;
    padding-top: 64px;
    padding-bottom: 104px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
    max-width: 800px;
  }

  .kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kicker span {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--blue);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 4.7vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .accent {
    color: var(--blue);
  }

  .lede {
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    max-width: 44ch;
    color: #3A3D42;
  }

  .count {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .count strong {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .hero-photo {
      width: 100%;
      max-width: none;
      height: 440px;
      aspect-ratio: auto;
      object-position: 50% 30%;
      -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    }

    .hero-fade {
      display: none;
    }

    .hero {
      padding-top: 290px;
      padding-bottom: 64px;
    }
  }
</style>
