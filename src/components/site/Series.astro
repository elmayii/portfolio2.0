---
import { series, latest } from '../../data/site';
---

<section id="read" class="wrap series">
  <div class="head">
    <div class="titles">
      <p class="eyebrow">The series</p>
      <h2 class="section-title">Four series. One enemy: the monthly bill.</h2>
    </div>

    <figure class="receipt" aria-label="Example of a monthly software bill being cut">
      <div class="row top">
        <span class="strong">YOUR SOFTWARE BILL</span>
        <span class="muted">/ MONTH</span>
      </div>
      <div class="lines">
        <div class="pair">
          <span class="strike">ManyChat Pro</span>
          <span class="strike num">$39.00</span>
          <span class="blue">→ my own DM bot</span>
          <span class="blue num">$0.00</span>
        </div>
        <div class="pair">
          <span>[Next app you pay for]</span>
          <span class="num">$[XX].00</span>
        </div>
      </div>
      <div class="pair total">
        <span>NOW YOU PAY</span>
        <span class="num">$0.00</span>
      </div>
      <figcaption>ManyChat Pro, monthly plan, Sep 2026.</figcaption>
    </figure>
  </div>

  <div class="cards">
    {
      series.map((s) => (
        <article>
          <h3>{s.name}</h3>
          <p class="formula mono">{s.formula}</p>
          <p class="text">{s.text}</p>
        </article>
      ))
    }
  </div>

  <div class="latest">
    <h2 class="eyebrow">Latest</h2>
    {
      latest.map((item) => (
        <a href={item.href} class="item">
          <span class="mono label">{item.label}</span>
          <span class="title">{item.title}</span>
          <span class:list={['mono', 'cta', { soon: item.cta === 'Soon' }]}>
            {item.cta}
            {item.cta !== 'Soon' && ' →'}
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .series {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 32px;
    align-items: center;
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .receipt {
    justify-self: end;
    width: 100%;
    max-width: 360px;
    box-sizing: border-box;
    margin: 0;
    padding: 22px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    transform: rotate(2deg);
    box-shadow: 0 18px 40px -18px rgba(18, 18, 18, 0.35);
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .top {
    padding-bottom: 12px;
    border-bottom: 1px dashed #B8BCC4;
  }

  .strong {
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .muted {
    color: var(--muted);
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px dashed #B8BCC4;
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
  }

  .receipt .strike {
    text-decoration-thickness: 2px;
  }

  .blue {
    color: var(--blue);
    font-weight: 600;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .total {
    padding-top: 12px;
    font-weight: 600;
  }

  figcaption {
    margin-top: 10px;
    font-size: 11px;
    color: var(--muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 16px;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 22px;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .formula {
    margin: 0;
    padding: 10px 12px;
    border-radius: 4px;
    background: var(--blue-tint);
    font-size: 13px;
  }

  .text {
    margin: 0;
    font-size: 16px;
    color: var(--body);
  }

  .latest {
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }

  .latest .eyebrow {
    margin-bottom: 12px;
    font-weight: 500;
  }

  .item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }

  .item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .label {
    font-size: 13px;
    color: var(--muted);
  }

  .title {
    font-size: 21px;
    font-weight: 600;
  }

  .cta {
    font-size: 13px;
    color: var(--blue);
  }

  .cta.soon {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .receipt {
      justify-self: start;
      transform: rotate(1deg);
    }

    .item {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .title {
      font-size: 19px;
    }
  }
</style>
