---
import { alternates, copy, langOf, type Lang } from '../../data/i18n';

interface Props {
  home?: boolean;
  lang?: Lang; // pages outside /es/ that are Spanish (/guia)
}

const { home = false, lang = langOf(Astro.currentLocale) } = Astro.props;
const root = lang === 'es' ? '/es/' : '/';
const base = home ? '' : root;
const { header: t } = copy(lang).ui;
const alt = alternates(Astro.url.pathname);
const other = lang === 'es' ? 'en' : 'es';
---

<header class:list={['site-header', { solid: !home }]}>
  <div class="wrap bar">
    <a href={root} class="brand" aria-label={t.home}>
      <img src="/brand-mark.svg" alt="" width="73" height="22" />
      <span class="name">Mario Perera</span>
      <span class="handle">sr_perera</span>
    </a>
    <nav aria-label={t.nav}>
      <a class="navlink" href={`${base}#read`}>{t.read}</a>
      <a class="navlink" href={`${base}#built`}>{t.builds}</a>
      <a class="navlink strong" href={`${base}#work`}>{t.work}</a>
      {
        alt && (
          <a class="lang-switch" href={alt[other]} hreflang={other} lang={other} aria-label={t.switchName} data-lang-switch={other}>
            {t.switch}
          </a>
        )
      }
      <a class="btn subscribe-btn" href={`${base}#join`}>{t.subscribe}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 2;
  }

  .site-header.solid {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand img {
    display: block;
    height: 22px;
    width: auto;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
  }

  .handle {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--blue);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
  }

  .navlink {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    padding: 12px 0;
  }

  .navlink.strong {
    color: var(--ink);
    font-weight: 600;
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--ink);
    padding: 12px 4px;
  }

  .subscribe-btn {
    height: 44px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 14px;
    box-shadow: 0 8px 20px -10px rgba(0, 87, 255, 0.6);
  }

  @media (max-width: 760px) {
    .navlink,
    .handle {
      display: none;
    }

    nav {
      gap: 8px 14px;
    }
  }

  /* Keep the wordmark, name and Subscribe on one line on phones */
  @media (max-width: 440px) {
    /* Room for the language switch: wordmark, switch and Subscribe stay on one line at 375px. */
    .bar {
      gap: 8px;
    }

    nav {
      gap: 8px 10px;
    }

    .lang-switch {
      padding: 12px 0;
    }

    .subscribe-btn {
      padding: 0 12px;
    }

    .brand {
      gap: 10px;
    }

    .brand img {
      height: 18px;
    }

    .name {
      font-size: 17px;
    }
  }

  @media (max-width: 380px) {
    .brand {
      gap: 8px;
    }

    .brand img {
      height: 16px;
    }

    .name {
      font-size: 16px;
    }
  }
</style>

<script>
  // The chosen language wins over browser detection (the head script in Layout.astro reads it).
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', a.dataset.langSwitch!);
      } catch {
        // Storage blocked: the link still opens the other language.
      }
    }),
  );
</script>
