---
import { copy, langOf } from '../../data/i18n';

const { doors, ui } = copy(langOf(Astro.currentLocale));
---

<section id="work" class="wrap work">
  <div class="titles">
    <p class="eyebrow">{ui.work.eyebrow}</p>
    <h2 class="section-title">{ui.work.title}</h2>
  </div>
  <div class="grid">
    {
      doors.map((d) => (
        <article>
          <p class="mono kicker">{d.kicker}</p>
          <h3>{d.title}</h3>
          <p class="text">{d.text}</p>
          <a class="link-arrow" href={d.href}>{d.cta} →</a>
        </article>
      ))
    }
  </div>
</section>

<section class="about">
  <div class="wrap about-inner">
    <img src="/favicon.svg" alt={ui.about.markAlt} width="132" height="132" />
    <div class="about-copy">
      <h2>{ui.about.title}</h2>
      <p>{ui.about.text}</p>
    </div>
  </div>
</section>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 16px;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .kicker {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 1.15;
  }

  .text {
    margin: 0;
    color: var(--body);
  }

  article .link-arrow {
    align-self: flex-start;
  }

  .about {
    border-top: 1px solid var(--rule);
  }

  .about-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .about img {
    border-radius: 22%;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .about p {
    margin: 0;
    max-width: 60ch;
    font-size: 18px;
    color: var(--body);
  }

  @media (max-width: 600px) {
    .about-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .about img {
      width: 96px;
      height: 96px;
    }
  }
</style>
