---
import '../styles/global.css';
import { socials } from '../data/site';
import { alternates, copy, langOf, type Lang } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  lang?: Lang;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { lang = langOf(Astro.currentLocale) } = Astro.props;
const { site } = copy(lang);
const {
  title = site.title,
  description = site.description,
  image = '/images/mario-portrait-bw.jpg',
  noindex = false,
} = Astro.props;
const alt = alternates(Astro.url.pathname);

const ogImage = new URL(image, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mario Perera',
  alternateName: ['sr_perera', 'srperera'],
  url: site.url,
  image: ogImage.toString(),
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Baskion Innovation' },
  alumniOf: 'Instituto Politécnico de la Habana (CUJAE)',
  knowsAbout: ['AI agents', 'Automation', 'Software architecture', 'LLM applications'],
  sameAs: socials.filter((s) => s.url.startsWith('http')).map((s) => s.url),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mario Perera" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {alt && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />}
    {
      alt && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />
          <link rel="alternate" hreflang="es" href={new URL(alt.es, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.en, Astro.site)} />
          {/* First visit: a Spanish browser goes to /es/. A choice stored by the language switch wins either way. */}
          <script is:inline define:vars={{ lang, twin: lang === 'es' ? alt.en : alt.es }}>
            var stored;
            try {
              stored = localStorage.getItem('lang');
            } catch (e) {}
            var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
            var want = stored || (/^es/i.test(first) ? 'es' : '');
            if ((want === 'es' || want === 'en') && want !== lang) location.replace(twin + location.search + location.hash);
          </script>
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
