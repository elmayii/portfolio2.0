---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { checkout, pricing, site } from '../data/site';

const faqs = [
  {
    q: 'What do I get?',
    a: 'Every post, the full archive, the files behind each build and access to the vault connector for your AI.',
  },
  {
    q: 'What stays free?',
    a: 'The weekly emails and the guides you ask for in my DMs. You lose nothing by staying free.',
  },
  {
    q: 'Can I cancel?',
    a: 'Anytime, from your account. You keep access until the end of the period you paid for.',
  },
];

const perks = [
  { title: 'The build files, not screenshots', text: 'Prompts, sheets and skills for every guide, ready to paste or install.' },
  {
    title: 'Your AI sets it up',
    text: 'Connect the vault to Claude or ChatGPT. It reads the pack and builds it with you, asking when it needs you.',
  },
  { title: 'A message from me', text: "I write to every new member myself. Tell me what you're building." },
];
---

<Layout title="You're in · Mario Perera" noindex>
  <SiteHeader />
  <main>
    <section class="wrap intro">
      <p class="eyebrow">Subscribed</p>
      <h1>You're in.</h1>
      <p class="lede">Your guide is on its way to your inbox. Nothing there in two minutes? Check spam and promotions.</p>
    </section>

    <section class="wrap">
      <div class="offer">
        <div class="offer-head">
          <p class="eyebrow">While you're here</p>
          <h2>Free shows you how. Members get the files.</h2>
          <p class="body">
            The free emails explain each build. Members get the build itself, ready for their AI to set up, plus everything
            already in the vault.
          </p>
        </div>

        <ul class="perks">
          {
            perks.map((p) => (
              <li>
                <strong>{p.title}</strong>
                <span>{p.text}</span>
              </li>
            ))
          }
        </ul>

        {
          (checkout.monthly || checkout.yearly) && (
            <div class="plans">
              {checkout.monthly && (
                <a class="plan featured" href={checkout.monthly}>
                  <span class="mono tag">MONTHLY · NEW READER OFFER</span>
                  <span class="price"
                    ><s>${pricing.monthly}</s><b>${pricing.intro}</b><span>/month</span></span
                  >
                  <span class="note">20% off your first 3 months, then ${pricing.monthly}/month.</span>
                  <span class="btn">Start monthly</span>
                </a>
              )}
              {checkout.yearly && (
                <a class="plan" href={checkout.yearly}>
                  <span class="mono tag">ANNUAL · NEW READER OFFER</span>
                  <span class="price"
                    ><s>${pricing.yearly}</s><b>${pricing.yearlyIntro}</b><span>/year</span></span
                  >
                  <span class="note">20% off your first year, then ${pricing.yearly}/year.</span>
                  <span class="btn dark">Start annual</span>
                </a>
              )}
            </div>
          )
        }

        <div class="fine">
          <span>Cancel anytime. Card receipt by email, easy to expense.</span>
          <span>Prefer Substack? <a href={`${site.substackUrl}/subscribe`}>Subscribe there</a> at the full price.</span>
        </div>
      </div>
    </section>

    <section class="wrap faq">
      <h2 class="eyebrow">Three questions</h2>
      {
        faqs.map((f) => (
          <div class="qa">
            <strong>{f.q}</strong>
            <span>{f.a}</span>
          </div>
        ))
      }
    </section>

    <div class="wrap stay">
      <a href="/">No thanks, I'll stay free</a>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 72px;
    padding-bottom: 48px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .lede {
    margin: 0;
    max-width: 46ch;
    font-size: 21px;
    color: var(--body);
  }

  .offer {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .offer-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .body {
    margin: 0;
    max-width: 60ch;
    color: var(--body);
  }

  .perks {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 24px;
  }

  .perks li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
    color: var(--body);
  }

  .perks strong {
    font-size: 20px;
    color: var(--ink);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    text-decoration: none;
    background: var(--paper);
  }

  .plan.featured {
    border: 2px solid var(--blue);
    background: #EEF3FF;
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .featured .tag {
    color: var(--blue);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }

  .price s {
    font-size: 18px;
    color: var(--muted);
  }

  .price b {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 52px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .note {
    color: var(--body);
  }

  .plan .btn {
    margin-top: 6px;
  }

  .btn.dark {
    background: var(--ink);
  }

  .fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
    color: var(--muted);
  }

  .faq {
    display: flex;
    flex-direction: column;
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .faq .eyebrow {
    margin-bottom: 16px;
    font-weight: 500;
  }

  .qa {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 8px 32px;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
    color: var(--body);
  }

  .qa:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .qa strong {
    font-size: 19px;
    color: var(--ink);
  }

  .stay {
    display: flex;
    justify-content: center;
    padding-bottom: 80px;
  }

  .stay a {
    padding: 12px 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .qa {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
