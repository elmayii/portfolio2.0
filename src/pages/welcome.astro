---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { site } from '../data/site';
// The member offer (perks, plans, FAQ) is hidden until the vault exists (DECISIONS 2026-10-27).
---

<Layout title="You're in · Mario Perera" noindex>
  <SiteHeader />
  <main>
    <section class="wrap intro">
      <p class="eyebrow">Subscribed</p>
      <h1>You're in.</h1>
      <p class="lede">
        One last step: confirm your subscription in the Substack tab that just opened.
        No new tab? <a href={`${site.substackUrl}/subscribe`}>Subscribe on Substack</a>.
      </p>
    </section>

    <div class="wrap stay">
      <a href="/">Back to the home page</a>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 72px;
    padding-bottom: 48px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .lede {
    margin: 0;
    max-width: 46ch;
    font-size: 21px;
    color: var(--body);
  }

  .stay {
    display: flex;
    justify-content: center;
    padding-bottom: 80px;
  }

  .stay a {
    padding: 12px 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }
</style>
